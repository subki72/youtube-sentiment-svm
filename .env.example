# Application Settings
APP_NAME=youtube-sentiment-svm
APP_ENV=development
LOG_LEVEL=INFO

# Model & Lexicon Configuration
MODEL_PATH=artifacts/sentiment_pipeline.joblib
ALLOW_REMOTE_LEXICON=false
SLANG_DICT_URL=https://raw.githubusercontent.com/nasalsabila/kamus-alay/master/colloquial-indonesian-lexicon.csv
HTTP_TIMEOUT_SECONDS=5.0

# API Server & Resilience Settings
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
